#!/usr/bin/env python3
"""First real adapter-only LoRA smoke test; independent of J.A.R.V.I.S. Chat.

Dry-run/validation uses Python stdlib only. --train downloads Qwen3-0.6B
(~1.5 GB), then updates adapter parameters on GPU and checkpoints each step.
"""
from __future__ import annotations
import argparse
import json
import os
from pathlib import Path
import signal
import sys
import time

MODEL_ID = "Qwen/Qwen3-0.6B"
ROOT = Path(__file__).resolve().parent
DEFAULT_DATA = ROOT / "data" / "starter.jsonl"
DEFAULT_OUTPUT = ROOT / "runs" / "qwen3-0.6b-smoke"
STOP_REQUESTED = False


def handle_stop(_signum, _frame):
    global STOP_REQUESTED
    STOP_REQUESTED = True
    print("[STOP] Przerwanie zamówione; zapiszę adapter po bieżącym kroku.", flush=True)


def load_examples(path: Path):
    if not path.is_file():
        raise ValueError(f"Brak danych: {path}")
    records = []
    for no, line in enumerate(path.read_text(encoding="utf-8").splitlines(), 1):
        if not line.strip():
            continue
        try:
            obj = json.loads(line)
        except json.JSONDecodeError as e:
            raise ValueError(f"Błędny JSONL wiersz {no}: {e}") from e
        if not isinstance(obj, dict) or not isinstance(obj.get("instruction"), str) or not isinstance(obj.get("response"), str):
            raise ValueError(f"Wiersz {no}: wymagane pola instruction, response typu string")
        ins, ans = obj["instruction"].strip(), obj["response"].strip()
        if not ins or not ans or len(ins) > 800 or len(ans) > 1200:
            raise ValueError(f"Wiersz {no}: puste lub zbyt długie dane")
        records.append((ins, ans))
    if len(records) < 2:
        raise ValueError("Wymagane co najmniej dwa przykłady")
    if len(records) > 5000:
        raise ValueError("Za dużo przykładów na pojedynczy eksperyment")
    return records


def atomic_json(path: Path, obj):
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(path.suffix + ".tmp")
    tmp.write_text(json.dumps(obj, ensure_ascii=False, indent=2), encoding="utf-8")
    os.replace(tmp, path)


def main():
    p = argparse.ArgumentParser(description="Qwen3-0.6B: real LoRA GPU smoke test")
    p.add_argument("--data", type=Path, default=DEFAULT_DATA)
    p.add_argument("--output", type=Path, default=DEFAULT_OUTPUT)
    p.add_argument("--steps", type=int, default=6)
    p.add_argument("--seq-len", type=int, default=128)
    p.add_argument("--lr", type=float, default=0.0002)
    p.add_argument("--train", action="store_true", help="Potwierdzam pobranie modelu i trening GPU")
    args = p.parse_args()
    if not 1 <= args.steps <= 200 or not 64 <= args.seq_len <= 512 or not 0 < args.lr <= 0.01:
        p.error("Zakresy: steps 1..200; seq-len 64..512; lr 0..0.01")
    examples = load_examples(args.data)
    print(f"Model: {MODEL_ID}; przykłady: {len(examples)}; kroki: {args.steps}; seq-len: {args.seq_len}")
    print(f"Adapter: {args.output.resolve()}")
    if not args.train:
        print("PREFLIGHT OK. Do pobrania modelu i treningu użyj --train")
        return 0
    if args.output.exists() and any(args.output.iterdir()):
        p.error("Katalog wynikowy nie jest pusty. Wybierz nowy --output, aby nie nadpisać checkpointu.")

    # Import after preflight: checks are fast and available without Torch.
    import torch
    from transformers import AutoModelForCausalLM, AutoTokenizer
    from peft import LoraConfig, TaskType, get_peft_model

    if not torch.cuda.is_available():
        raise RuntimeError("Brak CUDA; nie zaczynam treningu na CPU")
    device = torch.device("cuda:0")
    prop = torch.cuda.get_device_properties(0)
    if prop.total_memory < 7 * 1024**3:
        raise RuntimeError("Za mało VRAM do zaplanowanego eksperymentu")
    torch.manual_seed(42)
    print(f"GPU: {torch.cuda.get_device_name(0)}; VRAM {prop.total_memory / 1024**3:.1f} GiB", flush=True)
    print("Pobieram/odczytuję bazowy Qwen3-0.6B (może wymagać ~1.5 GB)...", flush=True)

    tokenizer = AutoTokenizer.from_pretrained(MODEL_ID, trust_remote_code=False)
    if tokenizer.pad_token_id is None:
        tokenizer.pad_token = tokenizer.eos_token
    precision = torch.bfloat16 if torch.cuda.is_bf16_supported() else torch.float16
    print(f"Precyzja: {precision}", flush=True)
    base = AutoModelForCausalLM.from_pretrained(MODEL_ID, dtype=precision, trust_remote_code=False)
    base.config.use_cache = False
    base.to(device)
    model = get_peft_model(base, LoraConfig(
        task_type=TaskType.CAUSAL_LM,
        r=8, lora_alpha=16, lora_dropout=0.05, bias="none",
        target_modules=["q_proj", "v_proj"],
    ))
    trainable = sum(param.numel() for param in model.parameters() if param.requires_grad)
    print(f"Trenowane parametry adaptera: {trainable:,}", flush=True)
    if trainable <= 0:
        raise RuntimeError("Brak trenowanych parametrów LoRA")
    optimizer = torch.optim.AdamW((x for x in model.parameters() if x.requires_grad), lr=args.lr)
    # Wariant z maską: strata liczona tylko na odpowiedzi, nie na instrukcji.
    samples = []
    for ins, ans in examples:
        prefix = tokenizer.apply_chat_template(
            [{"role":"user", "content":ins}],
            tokenize=False, add_generation_prompt=True, enable_thinking=False,
        )
        tail = ans + (tokenizer.eos_token or "")
        prefix_ids = tokenizer(prefix, add_special_tokens=False).input_ids
        answer_ids = tokenizer(tail, add_special_tokens=False).input_ids
        if len(answer_ids) < 2:
            raise ValueError("Odpowiedź po tokenizacji jest zbyt krótka")
        # Take the final prompt tokens to preserve at least 24 answer tokens.
        if len(answer_ids) > args.seq_len - 16:
            answer_ids = answer_ids[:args.seq_len - 16]
        prefix_ids = prefix_ids[-(args.seq_len - len(answer_ids)):]
        ids = prefix_ids + answer_ids
        labels = [-100] * len(prefix_ids) + answer_ids
        if len(ids) > args.seq_len or not any(v != -100 for v in labels[1:]):
            raise ValueError("Nieprawidłowy przykład po tokenizacji")
        samples.append((torch.tensor([ids], device=device), torch.tensor([labels], device=device)))

    args.output.mkdir(parents=True, exist_ok=True)
    signal.signal(signal.SIGINT, handle_stop)
    if hasattr(signal, 'SIGTERM'):
        signal.signal(signal.SIGTERM, handle_stop)
    stop_file = args.output / "STOP"
    print(f"START: {args.steps} kroków; Ctrl+C lub plik {stop_file} = STOP", flush=True)
    state = {"status":"running", "model":MODEL_ID, "step":0, "totalSteps":args.steps, "loss":None}
    atomic_json(args.output / "progress.json", state)
    model.train()
    try:
        for step in range(1, args.steps + 1):
            if STOP_REQUESTED or stop_file.is_file():
                state["status"] = "stopped"
                break
            tokens, labels = samples[(step - 1) % len(samples)]
            optimizer.zero_grad(set_to_none=True)
            result = model(input_ids=tokens, labels=labels, use_cache=False)
            loss = result.loss
            if not torch.isfinite(loss):
                raise RuntimeError(f"Loss nie jest skończony: {loss.item()}")
            loss.backward()
            torch.nn.utils.clip_grad_norm_((x for x in model.parameters() if x.requires_grad), 1.0)
            optimizer.step()
            state.update(step=step, loss=round(float(loss.detach().item()), 5),
                         allocatedVramMiB=round(torch.cuda.memory_allocated(device) / 1024**2))
            print(f"STEP {step}/{args.steps}: loss={state['loss']} VRAM={state['allocatedVramMiB']} MiB", flush=True)
            # Each step yields a usable adapter checkpoint. No overwrite of Chat models.
            model.save_pretrained(args.output / "adapter", safe_serialization=True)
            tokenizer.save_pretrained(args.output / "adapter")
            atomic_json(args.output / "progress.json", state)
        else:
            state["status"] = "completed"
        if state["status"] == "running":
            state["status"] = "stopped"
    except Exception as exc:
        state["status"] = "failed"
        state["error"] = f"{type(exc).__name__}: {exc}"
        atomic_json(args.output / "progress.json", state)
        raise
    atomic_json(args.output / "progress.json", state)
    print(f"WYNIK: {state['status']}; zapis: {args.output / 'adapter'}", flush=True)
    return 0 if state["status"] == "completed" else 2


if __name__ == "__main__":
    sys.exit(main())
