{
  "name": "jarvis-desktop",
  "version": "1.0.0",
  "description": "JARVIS - Personal AI Desktop Assistant",
  "main": "electron/main.cjs",
  "scripts": {
    "test": "node --test",
    "dev": "electron .",
    "preview": "electron . --preview",
    "build:ui": "npm --prefix ../frontend run build -- --base-href ./",
    "installer:win": "npm run build:ui && electron-builder --config electron-builder.config.cjs --win nsis --x64 --publish never",
    "pack:win": "npm run build:ui && electron-builder --config electron-builder.config.cjs --win --dir --x64 --publish never"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "private": true,
  "dependencies": {
    "debug": "^4.4.3",
    "env-paths": "^3.0.0",
    "graceful-fs": "^4.2.11",
    "ms": "^2.1.3",
    "progress": "^2.0.3",
    "semver": "^7.8.6",
    "sumchecker": "^3.0.1",
    "undici": "^7.30.2",
    "undici-types": "^7.24.6"
  }
}
